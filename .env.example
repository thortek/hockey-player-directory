# .env.example: safe to commit. Copy to .env.local and fill in real values.
# Never commit a filled .env or .env.local.

# -----------------------------------------------------------------------------
# PUBLIC (VITE_ prefix: Vite inlines these into the browser bundle)
# -----------------------------------------------------------------------------
VITE_APP_NAME=Hockey Operations Directory

# -----------------------------------------------------------------------------
# SECRET (server-only: NO VITE_ prefix)
# Read only inside server functions via getServerEnv() in src/config/env.ts.
# Leave both empty to serve the built-in seed roster.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
