# .env.example: safe to commit. Copy to .env.local and fill in real values.
# Never commit a filled .env or .env.local.

# -----------------------------------------------------------------------------
# PUBLIC (VITE_ prefix: Vite inlines these into the browser bundle)
# Used by both the browser client (src/lib/supabase/client.ts) and the
# session-aware server client (src/lib/supabase/server.ts). The publishable
# key is designed to be public; RLS decides what it can read.
# -----------------------------------------------------------------------------
VITE_APP_NAME=Hockey Operations Directory
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# -----------------------------------------------------------------------------
# SECRET (server-only: NO VITE_ prefix)
# Read only through getServerEnv() in src/config/env.ts. The secret key
# bypasses RLS: it is never used on a signed-in staff request path.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key

# Local tooling only (migrations, typegen). Never set in Vercel.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
